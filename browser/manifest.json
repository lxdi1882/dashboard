{
  "manifest_version": 3,
  "name": "Dashboard Site Time",
  "version": "1.0.0",
  "description": "Share local, domain-only foreground time with the Noctalia dashboard.",
  "key": "",
  "incognito": "not_allowed",
  "permissions": [
    "alarms",
    "idle",
    "nativeMessaging",
    "storage"
  ],
  "optional_permissions": [
    "tabs",
    "favicon"
  ],
  "background": {
    "service_worker": "worker.js"
  },
  "action": {
    "default_title": "Dashboard Site Time",
    "default_popup": "popup.html"
  }
}
